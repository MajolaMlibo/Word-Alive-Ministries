    "plugins": [
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "966c4966-bf09-4419-8652-2c5642b7503f"
      }
    },

    "owner": "Word Alive Ministries"
