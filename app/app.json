{
  "expo": {
    "name": "Word Alive Ministries",
    "slug": "word-alive-ministries",
    "scheme": "wordalive-ministries",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",

    "ios": {
      "bundleIdentifier": "com.wordaliveministries.app",
      "supportsTablet": true
    },

    "android": {
      "package": "com.wordaliveministries.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },

    "plugins": [
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Word Alive Ministries to access your photos so you can set a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "966c4966-bf09-4419-8652-2c5642b7503f"
      }
    },

    "owner": "mlibo"
  }
}
